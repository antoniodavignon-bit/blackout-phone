#!/data/data/com.termux/files/usr/bin/bash
# status — five-second health check. Answers "is this device sound?" offline.
#
# Honest by design: it reports what it can actually read, and says plainly
# what it cannot. Android 11 blocks Termux from /storage/<card>/Android/data,
# which is where OsmAnd keeps its maps, so the map count is a RECORD written
# from the Mac at copy time, not a live count. A check that cannot see its
# subject must not claim to have verified it.
set -u
CARD="/storage/0CEC-1F1B"
ZIMS="$CARD/Kiwix"
REF="$CARD/Reference"
MANIFEST="$REF/MAPS.manifest"
VAULT="$HOME/storage/shared/DMG"
INBOX="$VAULT/inbox/capture.md"
ZIM_EXPECTED=18

ok()   { printf '  OK    %s\n' "$*"; }
note() { printf '  NOTE  %s\n' "$*"; }
warn() { printf '  WARN  %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*"; }

echo "blackout status — $(date '+%Y-%m-%d %H:%M')"
echo

echo "storage"
printf '  internal free : %s\n' "$(df -h "$HOME" 2>/dev/null | awk 'NR==2{print $4}')"
if [ -d "$CARD" ]; then
  printf '  card free     : %s\n' "$(df -h "$CARD" 2>/dev/null | awk 'NR==2{print $4}')"
else
  bad "card not mounted at $CARD"
fi
echo

echo "library"
if [ -d "$ZIMS" ]; then
  n=$(find "$ZIMS" -maxdepth 1 -name '*.zim' 2>/dev/null | wc -l | tr -d ' ')
  if [ "$n" -ge "$ZIM_EXPECTED" ]; then ok "zims: $n"; else warn "zims: $n (expected $ZIM_EXPECTED)"; fi
else
  bad "Kiwix directory missing"
fi

if [ -f "$MANIFEST" ]; then
  mcount=$(awk -F'=' '/^count=/{print $2}' "$MANIFEST" 2>/dev/null)
  mdate=$(awk -F'=' '/^written=/{print $2}' "$MANIFEST" 2>/dev/null)
  note "maps: ${mcount:-?} recorded ${mdate:-?} — not verifiable here (Android/data is unreadable from Termux)"
else
  warn "no MAPS.manifest — run scripts/mac/card-manifest.sh with the card in the Mac"
fi

if [ -f "$REF/CATALOG.md" ]; then ok "CATALOG.md present"; else warn "CATALOG.md missing"; fi
echo

echo "capture"
if [ -f "$INBOX" ]; then
  ok "$(wc -l < "$INBOX" | tr -d ' ') notes, last $(date -r "$INBOX" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?')"
else
  warn "no captures yet"
fi
echo

echo "power"
if command -v termux-battery-status >/dev/null 2>&1; then
  termux-battery-status 2>/dev/null \
    | tr -d '",{}' \
    | awk -F: '/percentage|status/ {gsub(/^[ \t]+/,"",$1); gsub(/^[ \t]+/,"",$2); printf "  %-13s: %s\n", $1, $2}'
else
  warn "termux-api not installed — no battery reading"
fi
